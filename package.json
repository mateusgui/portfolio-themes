{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "test:coverage": "npm run test:coverage -w web",
    "test:e2e": "npm run test:e2e -w web",
    "resume": "npm run resume -w web",
    "og": "npm run og -w web",
    "avatars": "npm run avatars -w web --",
    "screenshots": "npm run screenshots -w web",
    "format": "prettier --write apps .github \"*.{md,json,jsonc}\" .prettierrc.json",
    "format:check": "prettier --check apps .github \"*.{md,json,jsonc}\" .prettierrc.json",
    "check": "npm run format:check && npm run check -w web"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
